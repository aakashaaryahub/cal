<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Debug builds only: render with OpenGL instead of Impeller/Vulkan.
         Emulators without a usable host GPU fall back to the software Vulkan
         driver (lavapipe), which segfaults the emulator on this app's home
         screen. Release builds keep Impeller. -->
    <!-- Plain HTTP to the local backend (10.0.2.2). Release builds use HTTPS. -->
    <application android:usesCleartextTraffic="true">
        <meta-data
            android:name="io.flutter.embedding.android.EnableImpeller"
            android:value="false" />
    </application>
</manifest>
