PORT=3000
# Use a long random string in production
JWT_SECRET=change-me-in-production
# NODE_ENV=production   # disables debug OTPs and dev payments

# Daily voice calls (dashboard.daily.co -> Developers -> API key). Unset = calls are off.
DAILY_API_KEY=

# Google Play Billing. Each plan is a Play in-app product with the same ID.
# The JSON is the service account key file's contents, on one line. Without
# these, purchases run in dev mode (outside production).
GOOGLE_PLAY_PACKAGE=com.voxlink.app
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

# SMS for OTPs via PowersText (bulk.powerstext.in, DLT). Without these, OTPs are
# printed to the console and shown in the app (outside production).
# The message text is fixed in src/sms.js and must match the DLT template.
POWERSTEXT_AUTH_KEY=
POWERSTEXT_SENDER_ID=
POWERSTEXT_TEMPLATE_ID=
POWERSTEXT_ROUTE=1

# Shown as the contact address on /privacy (required by Google Play).
SUPPORT_EMAIL=

# Login for Google Play's reviewers: this number skips the SMS and accepts
# REVIEW_OTP (6 digits). Give both in Play Console -> App content -> App access.
REVIEW_PHONE=
REVIEW_OTP=

# Admin dashboard at http://localhost:3000/admin. Password min 8 chars. Unset = disabled.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Admin API token for scripts (curl), sent as x-admin-token (min 16 chars). Unset = disabled.
ADMIN_TOKEN=

# Folder holding voxlink.sqlite. Defaults to backend/data. On Render, set this to
# the disk's mount path (e.g. /var/data) or data is wiped on redeploy.
# DATA_DIR=
